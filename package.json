{
  "name": "auto-agent-claude-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code plugin that receives UI feedback from the Auto Agent browser extension and hands it to Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "bump-version-patch": "node scripts/bump-version.mjs patch && pnpm build",
    "bump-version-minor": "node scripts/bump-version.mjs minor && pnpm build",
    "bump-version-major": "node scripts/bump-version.mjs major && pnpm build",
    "test": "vitest run",
    "test:e2e": "node scripts/bundle.mjs && vitest run --config vitest.e2e.config.ts",
    "compile": "tsc --noEmit && pnpm --filter @auto-agent/protocol compile"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@auto-agent/protocol": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
