{
  "name": "auto-agent-mcp",
  "version": "1.1.0",
  "description": "Local MCP server that receives UI feedback from the Auto Agent browser extension and hands it to your coding agent.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude-code",
    "frontend",
    "feedback",
    "browser-extension"
  ],
  "author": "ledutu <ledutu.it@gmail.com>",
  "homepage": "https://github.com/ledutu-studio/auto-agent-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledutu-studio/auto-agent-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ledutu-studio/auto-agent-mcp/issues"
  },
  "type": "module",
  "bin": {
    "auto-agent-mcp": "plugin/dist/server.mjs"
  },
  "files": [
    "plugin/dist",
    "README.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/bundle.mjs && vitest run --config vitest.e2e.config.ts",
    "compile": "tsc --noEmit && pnpm --filter @auto-agent/protocol compile"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@auto-agent/protocol": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
